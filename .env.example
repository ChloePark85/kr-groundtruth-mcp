# Public base URL (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Supabase (service role — server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstream keys
DATA_GO_KR_KEY=        # data.go.kr 일반 인증키(Decoding). 국세청 사업자등록 + 국토부 실거래가 활용신청 필요
JUSO_KEY=              # business.juso.go.kr 승인키
DART_KEY=              # opendart.fss.or.kr API 인증키
LAW_OC=                # law.go.kr OPEN API 신청 시 사용한 이메일 ID (승인 후 사용 가능)

# Toss Payments
TOSS_CLIENT_KEY=test_gck_...
TOSS_SECRET_KEY=test_gsk_...

# Billing knobs
CREDIT_KRW=10
SIGNUP_BONUS_CREDITS=50
MIN_TOPUP_CREDITS=100
SIGNUPS_PER_IP_PER_DAY=3

# admin metrics endpoint (x-admin-token header)
ADMIN_TOKEN=
